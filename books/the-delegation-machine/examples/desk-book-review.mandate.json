  "intent": {
    "statement": "Prepare The Delegation Machine for review without changing publication state or unrelated Desk work.",
    "success_signals": [
      "The book package is reviewable in one scoped PR",
      "Required discovery surfaces accurately reference the book"
    ],
    "unacceptable_outcomes": [
      "Release unpublished material to Shelf",
      "Overwrite unrelated concurrent book work",
      "Claim completion without repository evidence"
    ]
  },
  "mandate": {
    "task": "Prepare The Delegation Machine book package and required Desk discovery surfaces for review.",
    "completion_criteria": [
      "Book package and companion files are committed",
      "PR changed-file list is scoped",
      "PR patches and mergeability are reviewed"
    ],
    "stop_conditions": [
      "A Shelf release is requested without explicit authorization",
      "A concurrent change creates an unresolved catalog conflict",
      "Required evidence cannot be independently verified"
    ],
    "exclusions": [
      "Do not modify other manuscripts",
      "Do not change Bookself framework behavior"
    ]
  },
  "authority": {
    "grants": [
      {
        "resource": "Svyable/desk",
        "actions": [
          "read"
        ]
      },
      {
        "resource": "Svyable/desk:book/the-delegation-machine",
        "actions": [
          "write"
        ],
        "constraints": [
          "books/the-delegation-machine/**",
          "required Desk discovery surfaces only"
        ]
      }
    ],
    "limits": [
      {
        "dimension": "publication_state",
