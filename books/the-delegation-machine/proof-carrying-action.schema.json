{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://svyable.github.io/desk/books/the-delegation-machine/proof-carrying-action.schema.json",
  "title": "Proof-Carrying Action Receipt",
  "description": "A machine-readable receipt for delegated action. It records what changed, which authority was used, what independent evidence exists, remaining uncertainty, review state, and how the action can be reversed or contained.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action_id",
    "mandate_id",
    "principal",
    "delegate",
    "status",
    "action",
    "authority_used",
    "evidence",
    "uncertainty",
    "reversal",
    "next_obligations",
    "timing"
  ],
  "properties": {
    "schema_version": {
      "const": "proof-carrying-action/0.1"
    },
    "action_id": {
      "type": "string",
      "minLength": 1
    },
    "mandate_id": {
      "type": "string",
      "minLength": 1
    },
    "mandate_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "principal": {
      "$ref": "#/$defs/actor"
    },
    "delegate": {
      "$ref": "#/$defs/actor"
    },
    "status": {
      "enum": [
        "in_progress",
        "completed",
        "partial",
        "blocked",
        "failed",
        "rolled_back"
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "state_changes"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "state_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state_change"
          }
        }
      }
    },
    "authority_used": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grants",
        "exceptions"
      ],
      "properties": {
        "grants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/authority_use"
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/authority_use"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipts",
        "completion_supported_by_independent_evidence"
      ],
      "properties": {
        "receipts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence_receipt"
          }
        },
        "completion_supported_by_independent_evidence": {
          "type": "boolean"
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "known_unknowns",
        "unverified_claims"
      ],
      "properties": {
        "known_unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unverified_claims": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reversal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reversible",
        "status",
        "method",
        "deadline"
      ],
      "properties": {
        "reversible": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "not_required",
            "available",
            "executed",
            "unavailable"
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "deadline": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "next_obligations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/obligation"
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recorded_at"
      ],
      "properties": {
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "review_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "triggers_hit",
        "status"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "triggers_hit": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": [
            "not_required",
            "pending",
            "accepted",
            "rejected"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "previous_receipt_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "issued_by": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "completion_supported_by_independent_evidence": {
                "const": true
              },
              "receipts": {
                "contains": {
                  "type": "object",
                  "properties": {
                    "independent_of_delegate": {
                      "const": true
                    }
                  },
                  "required": [
                    "independent_of_delegate"
                  ]
                },
                "minContains": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "rolled_back"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reversal": {
            "properties": {
              "status": {
                "const": "executed"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "human",
            "organization",
            "software",
            "ai_agent",
            "service",
            "other"
          ]
        },
        "display_name": {
          "type": "string"
        }
      }
    },
    "state_change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource",
        "operation",
        "reference",
        "reversible"
      ],
      "properties": {
        "resource": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "reversible": {
          "type": "boolean"
        }
      }
    },
    "authority_use": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource",
        "actions",
        "basis"
      ],
      "properties": {
        "resource": {
          "type": "string",
          "minLength": 1
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source",
        "reference",
        "independent_of_delegate"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "independent_of_delegate": {
          "type": "boolean"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "digest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "due": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
